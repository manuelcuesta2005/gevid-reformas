---
const pasos = [
  {
    etiqueta: "Presentación de propuesta",
    titulo: "Propuesta clara y transparente",
    descripcion:
      "Escuchamos tus ideas y necesidades para elaborar un presupuesto detallado y sin sorpresas. Analizamos las mejores opciones técnicas para optimizar tu inversión desde el primer momento.",
    icono: `<circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" />`,
  },
  {
    etiqueta: "Estudio del proyecto",
    titulo: "Planificación rigurosa",
    descripcion:
      "Evaluamos la viabilidad, materiales, normativa y plazos de ejecución. Trazamos una hoja de ruta técnica precisa antes de iniciar cualquier labor en la obra.",
    icono: `<rect x="5" y="4" width="14" height="17" /><path d="M9 4V3h6v1M9 11h6M9 15h4" />`,
  },
  {
    etiqueta: "Comencemos a trabajar",
    titulo: "Ejecución y compromiso",
    descripcion:
      "Ponemos a nuestro equipo en marcha bajo estricta supervisión y máxima seguridad. Nos enfocamos en la calidad, la limpieza y la entrega puntual en la fecha acordada.",
    icono: `<rect x="3" y="5" width="18" height="14" /><path d="M3 12h18M9 5v7M15 12v7" />`,
  },
];
---

<section id="metodologia" class="w-full bg-[#1c1c1c] px-6 py-16 text-white sm:px-8 md:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-[#EF5F17]">¿Cómo funciona nuestro modelo?</p>
      <h2 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-balance sm:text-4xl lg:text-5xl">
        Metodología de trabajo
      </h2>
    </div>

    <ol class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8 lg:mt-16 lg:gap-12">
      {pasos.map((p, i) => (
        <li class="relative border-t border-white/15 pt-6 before:absolute before:-top-px before:left-0 before:h-0.5 before:w-12 before:bg-[#EF5F17]">
          <div class="flex items-start justify-between gap-4">
            <p class="text-sm text-white/60">
              <span class="font-semibold text-[#EF5F17]">{String(i + 1).padStart(2, "0")}</span>
              <span class="mx-1.5">/</span>{p.etiqueta}
            </p>
            <svg class="h-6 w-6 shrink-0 text-white/70" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={p.icono} />
            </svg>
          </div>

          <h3 class="mt-6 text-xl font-semibold tracking-tight">{p.titulo}</h3>
          <p class="mt-3 text-base leading-relaxed text-white/70">{p.descripcion}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
---
interface Props {
  /** Endpoint que recibirá el POST (tu API route, Formspree, etc.) */
  action?: string;
}

const { action = "/api/contacto" } = Astro.props;

const servicios = [
  "Reformas integrales",
  "Rehabilitación de fachadas",
  "Alquiler y montaje de andamios",
  "Otro",
];

const label = "mb-2 block text-sm text-white/80";

const field =
  "w-full border border-white/15 bg-transparent px-3.5 py-3 text-base text-white placeholder:text-white/40 hover:border-white/30 focus:border-[#EF5F17] focus:outline-none focus:ring-1 focus:ring-[#EF5F17]";
---

<form
  id="solicitar-presupuesto"
  action={action}
  method="POST"
  class="form-contacto w-full border-t-2 border-[#EF5F17] bg-white/4 p-6 sm:p-8"
>
  <h3 class="mb-6 text-2xl font-semibold tracking-tight text-white">
    Solicitar presupuesto
  </h3>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="nombre" class={label}>Nombre</label>
      <input type="text" id="nombre" name="nombre" class={field} placeholder="Tu nombre" autocomplete="name" required />
    </div>

    <div>
      <label for="email" class={label}>Correo electrónico</label>
      <input type="email" id="email" name="email" class={field} placeholder="Tu correo electrónico" autocomplete="email" required />
    </div>

    <div>
      <label for="telefono" class={label}>Teléfono</label>
      <input type="tel" id="telefono" name="telefono" inputmode="tel" minlength="9" class={field} placeholder="Tu teléfono" autocomplete="tel" required />
    </div>

    <div>
      <label for="servicio" class={label}>Servicio</label>
      <div class="relative">
        <select id="servicio" name="servicio" class={`${field} cursor-pointer appearance-none pr-10 invalid:text-white/40`} required>
          <option value="" disabled selected hidden>Selecciona un servicio</option>
          {servicios.map((s) => <option value={s} class="bg-[#1c1c1c] text-white">{s}</option>)}
        </select>
        <svg class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-white/60" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m5 8 5 5 5-5" />
        </svg>
      </div>
    </div>

    <div class="sm:col-span-2">
      <label for="mensaje" class={label}>Cuéntanos tu proyecto</label>
      <textarea id="mensaje" name="mensaje" rows="5" class={`${field} resize-y`} placeholder="Qué quieres reformar o qué necesita tu edificio..." required></textarea>
    </div>
  </div>

  <label class="mt-6 flex cursor-pointer items-start gap-3 text-sm text-white/70">
    <input type="checkbox" name="privacidad" class="mt-0.5 h-4 w-4 shrink-0 accent-[#EF5F17]" required />
    <span>
      He leído y acepto la
      <a href="/politica-de-privacidad" class="text-white underline decoration-[#EF5F17] underline-offset-4 hover:text-[#EF5F17]">política de privacidad</a>.
    </span>
  </label>

  <button
    type="submit"
    class="mt-6 w-full bg-[#EF5F17] px-6 py-3.5 text-sm font-semibold text-[#1c1c1c] transition-colors duration-200 hover:bg-white focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"
  >
    Enviar solicitud ↗
  </button>
</form>

<style>
  /* Evita el fondo claro del autocompletado del navegador */
  .form-contacto input:-webkit-autofill,
  .form-contacto input:-webkit-autofill:focus,
  .form-contacto textarea:-webkit-autofill {
    -webkit-text-fill-color: #ffffff;
    box-shadow: 0 0 0 1000px #232323 inset;
    caret-color: #ffffff;
    transition: background-color 9999s ease-in-out 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .form-contacto * {
      transition-duration: 0.01ms !important;
    }
  }
</style>
---
import Logo from "../assets/gevid-reformas.png";
import { Image } from "astro:assets";

const pathname = Astro.url.pathname;

const enlaces = [
  { texto: "Inicio", href: "/" },
  { texto: "Servicios", href: "/#servicios" },
  { texto: "Proyectos", href: "/#proyectos" },
  { texto: "Empresa", href: "/#empresa" },
];

const enlace =
  "relative block border-b border-white/10 py-3.5 text-base text-white/80 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white md:border-0 md:py-1 md:text-[15px] " +
  "after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-[#EF5F17] after:transition-transform hover:after:scale-x-100 aria-[current=page]:text-white aria-[current=page]:after:scale-x-100 max-md:after:hidden";

const cta =
  "bg-[#EF5F17] px-5 py-2.5 text-sm font-semibold text-[#1c1c1c] transition-colors duration-200 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#1c1c1c] backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 sm:px-8 md:h-20">
    <a href="/" class="flex shrink-0 items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white" aria-label="Gevid Reformas, ir al inicio">
      <Image src={Logo} alt="Gevid Reformas" loading="eager" class="h-9 w-auto md:h-11" />
    </a>

    <!-- Navegación: panel desplegable en móvil, fila centrada en escritorio -->
    <nav
      id="navbar-principal"
      aria-label="Principal"
      class="hidden absolute inset-x-0 top-full border-b border-white/10 bg-[#1c1c1c] px-6 pb-6 pt-1 sm:px-8 md:static md:flex md:flex-1 md:justify-center md:border-0 md:bg-transparent md:p-0"
    >
      <ul class="flex flex-col md:flex-row md:items-center md:gap-9">
        {enlaces.map((e) => (
          <li>
            <a href={e.href} class={enlace} aria-current={pathname === e.href ? "page" : undefined}>
              {e.texto}
            </a>
          </li>
        ))}
        <li class="mt-5 md:hidden">
          <a href="/#contacto" class={`${cta} block text-center`}>Contáctenos</a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/#contacto" class={`${cta} hidden md:inline-block`}>Contáctenos</a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center text-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white md:hidden"
        aria-controls="navbar-principal"
        aria-expanded="false"
      >
        <span class="sr-only">Abrir menú principal</span>
        <svg data-icon="abrir" class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 7h14M5 12h14M5 17h14" /></svg>
        <svg data-icon="cerrar" class="hidden h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>
</header>

<!-- Evita que el header fijo tape los títulos al navegar a #servicios, #contacto, etc. -->
<style is:global>
  html {
    scroll-padding-top: 5rem;
  }
</style>

<script>
  function initMenu() {
    const btn = document.getElementById("menu-toggle");
    const panel = document.getElementById("navbar-principal");
    if (!btn || !panel || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    const iconAbrir = btn.querySelector('[data-icon="abrir"]');
    const iconCerrar = btn.querySelector('[data-icon="cerrar"]');
    const label = btn.querySelector(".sr-only");

    function setOpen(open: boolean) {
      panel!.classList.toggle("hidden", !open);
      btn!.setAttribute("aria-expanded", String(open));
      iconAbrir?.classList.toggle("hidden", open);
      iconCerrar?.classList.toggle("hidden", !open);
      if (label) label.textContent = open ? "Cerrar menú principal" : "Abrir menú principal";
    }

    btn.addEventListener("click", () => {
      setOpen(btn.getAttribute("aria-expanded") !== "true");
    });

    // Cierra al elegir un enlace
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });

    // Cierra con Escape y devuelve el foco al botón
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        btn.focus();
      }
    });

    // Al pasar a escritorio, restablece el estado
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  initMenu();
  document.addEventListener("astro:page-load", initMenu);
</script>